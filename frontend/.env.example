# Optional: public URL encoded in the Share QR (overrides profile.shareUrl).
# VITE_SITE_URL=https://poojalakshmis.github.io/portfolio/

VITE_SITE_URL=

# GitHub Pages / subpath: CI sets VITE_BASE_PATH (e.g. "/portfolio/"). Local dev: leave unset or use "/".
# VITE_BASE_PATH=/

# When the API is hosted separately (e.g. Render), set the gateway origin without trailing slash:
# VITE_API_BASE_URL=https://your-gateway.onrender.com

VITE_API_BASE_URL=
